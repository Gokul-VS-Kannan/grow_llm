    "# Step 1: Connect LangChain to Ollama\n",
    "# Goal: Create a LangChain llm object that talks to local Ollama\n",
    "from langchain_ollama import ChatOllama\n",
    "\n",
    "llm = ChatOllama(\n",
    "    model=\"qwen3:0.6b\",\n",
    "    temperature=0\n",
    ")\n",
    "\n",
    "print(type(llm))\n",
    "print(\"Langchain is connected to Ollama\")"
   ]
  }
